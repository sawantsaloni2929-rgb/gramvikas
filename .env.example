# GramVikas Server & Services Configuration
# Copy this file to .env and customize with your production credentials

# Server Configuration
PORT=5000
SERVER_ENV=development
JWT_SECRET=gramvikas_secure_jwt_secret_change_in_production_2026

# Database Configuration (Optional: for external MySQL / PostgreSQL)
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gramvikas_db
# DB_USER=gramvikas_user
# DB_PASSWORD=your_secure_db_password

# SMS Gateway Integration (MSG91)
# Sign up at https://msg91.com to obtain authorization key
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=GRMVIK
MSG91_DLT_TE_ID_LOW_STOCK=1107161234567890123
MSG91_DLT_TE_ID_PAYMENT_REMINDER=1107161234567890124
MSG91_DLT_TE_ID_ORDER_STATUS=1107161234567890125

# Twilio SMS Gateway Fallback (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Rate Limiting & Demo Fallback
SMS_SIMULATION_MODE=true
MAX_SMS_PER_DAY_PER_RECIPIENT=3
ENABLE_NATIVE_SMS_FALLBACK=true
